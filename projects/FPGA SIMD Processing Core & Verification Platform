            font-size: 0.94rem;

            font-weight: 700;
        }


        .brand-dot {

            width: 7px;

            height: 7px;

            border-radius: 50%;

            background:
                var(--accent);
        }


        .nav-links {

            display: flex;

            align-items: center;

            gap: 22px;

            color:
                var(--text-soft);

            font-size: 0.8rem;

            font-weight: 600;
        }


        .nav-links a:hover {

            color:
                var(--accent);
        }



        /* BUTTONS */

        .button {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding:
                10px 15px;

            color: white;

            background:
