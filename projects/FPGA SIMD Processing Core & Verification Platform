            line-height: 1.65;
        }


        a {
            color: inherit;
            text-decoration: none;
        }


        .container {

            width:
                min(1080px, 91%);

            margin: 0 auto;
        }



        /* NAVIGATION */

        nav {

            position: sticky;

            top: 0;

            z-index: 1000;

            background:
                rgba(243, 242, 238, 0.95);

            border-bottom:
